{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/pavo.tsbuildinfo",
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
